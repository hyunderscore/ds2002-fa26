        "import pandas as pd, numpy as np\n",
        "from io import StringIO\n",
        "rng = np.random.default_rng(5)\n",
        "items = ['Cheeseburger','cheese burger','Foam Finger','foam finger','Rain Poncho','rain poncho']\n",
